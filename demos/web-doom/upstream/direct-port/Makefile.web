	grep -q "P_CheckPosition" doom_control.c
	grep -q 'memcpy(header, "PWAD"' doom_control.c

validate-mcp:
	@test -n "$(GITHUB_WORKSPACE)" || (echo "GITHUB_WORKSPACE is required" && false)
	test -f $(MCP_SERVER)
	test -f $(MCP_PLAYTEST_SERVER)
	test -f $(MCP_V1_SERVER)
	test -f $(MCP_CHEAT_SERVER)
	test -f $(MCP_ORCHESTRATOR)
	test -f $(MCP_PACKAGE)
	@test -n "$$EMSDK_NODE" || (echo "EMSDK_NODE is required" && false)
	chmod +x "$$EMSDK_NODE"
	"$$EMSDK_NODE" --check $(MCP_SERVER)
	"$$EMSDK_NODE" --check $(MCP_PLAYTEST_SERVER)
	"$$EMSDK_NODE" --check $(MCP_V1_SERVER)
	"$$EMSDK_NODE" --check $(MCP_CHEAT_SERVER)
	"$$EMSDK_NODE" --check $(MCP_ORCHESTRATOR)
	"$$EMSDK_NODE" -e "JSON.parse(require('fs').readFileSync('$(MCP_PACKAGE)', 'utf8')); console.error('MCP package.json valid')"
	npm install --prefix $(MCP_DIR) --ignore-scripts --no-audit --no-fund
	"$$EMSDK_NODE" --input-type=module -e "import { pathToFileURL } from 'node:url'; const m = await import(pathToFileURL('$(MCP_CHEAT_SERVER)').href); const s = m.createMcpServer(); if (!s) process.exit(1); console.error('MCP v1.1 cheats/audio import/self-test passed')"
	"$$EMSDK_NODE" --input-type=module -e "import { pathToFileURL } from 'node:url'; const o = await import(pathToFileURL('$(MCP_ORCHESTRATOR)').href); if (o.ORCHESTRATOR_VERSION !== '1.0.0') process.exit(1); console.error('MCP v1 orchestrator helpers self-test passed')"
	grep -q "doom_get_state" $(MCP_SERVER)
	grep -q "doom_get_enemies" $(MCP_SERVER)
	grep -q "doom_get_sectors" $(MCP_SERVER)
	grep -q "doom_set_sector_light" $(MCP_SERVER)
	grep -q "doom_get_linedefs" $(MCP_SERVER)
	grep -q "doom_set_linedef_action" $(MCP_SERVER)
	grep -q "doom_activate_linedef" $(MCP_SERVER)
	grep -q "doom_get_visuals" $(MCP_SERVER)
	grep -q "doom_list_visual_assets" $(MCP_SERVER)
	grep -q "doom_set_wall_texture" $(MCP_SERVER)
	grep -q "doom_set_sector_flat" $(MCP_SERVER)
	grep -q "doom_spawn_enemy" $(MCP_SERVER)
	grep -q "doom_remove_nearest_enemy" $(MCP_SERVER)
	grep -q "doom_get_changeset" $(MCP_SERVER)
	grep -q "doom_export_pwad" $(MCP_SERVER)
	grep -q "doom_list_exports" $(MCP_SERVER)
	grep -q "doom_load_pwad" $(MCP_SERVER)
	grep -q "doom_reload_current_map" $(MCP_SERVER)
	grep -q "doom_pause_playtest" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_resume_playtest" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_step_tics" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_get_playtest_telemetry" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_reset_playtest_metrics" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_capture_frame" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_agent_input_status" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_cancel_agent_input" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_run_input" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_run_input_sequence" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_run_design_trial" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_evaluate_playtest" $(MCP_PLAYTEST_SERVER)
	grep -q "doom_begin_design_session" $(MCP_V1_SERVER)
	grep -q "doom_run_authoring_iteration" $(MCP_V1_SERVER)
