	grep -q "type: 'image'" $(MCP_PLAYTEST_SERVER)
	grep -q "serveStdio" $(MCP_CHEAT_SERVER)

webdoom.html: $(SOURCES) doom1.wad shell.html
	@rm -f emcc-build.log
	@($(CC) $(CFLAGS) $(SOURCES) -o $@ $(EMFLAGS) $(EXTRA_EMFLAGS) -lm >emcc-build.log 2>&1) || { \
		echo "===== Emscripten failure diagnostics ====="; \
		tail -n 240 emcc-build.log; \
		exit 1; \
	}
	@tail -n 40 emcc-build.log

clean:
	rm -rf choco_opl
	rm -f doom_control.c doom_linedefs.c doom_visuals.c doom_playtest.c doom_agent_input.c doom_reload.c doom_cheats.c
	rm -f webdoom.html webdoom.js webdoom.wasm webdoom.data emcc-build.log
